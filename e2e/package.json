{
  "name": "@gravity-run/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:replay": "playwright test tests/replay.spec.ts",
    "test:perf": "playwright test tests/perf.spec.ts",
    "update-snapshots": "playwright test --update-snapshots tests/visual.spec.ts",
    "install-browsers": "playwright install --with-deps chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@gravity-run/shared": "workspace:*"
  }
}
