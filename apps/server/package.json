{
  "name": "@gravity-run/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gravity-run/game-config": "workspace:*",
    "@gravity-run/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
